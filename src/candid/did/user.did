service : {
  approveCycleWithdrawal: (nat) -> ();
  createEventMetaData: (EventMetadataRequestPayload) -> (Result);
  fetchCanisterStatus: (opt principal) -> (CanisterStatus);
  generateSchema: () -> (text);
  getAccountIdentifier: () -> (text) query;
  getAllEventsMetadata: () -> (Result_2) query;
  getAllEventsMetadataForUser: () -> (Result_2) query;
  getCalendarId: (text) -> (text) query;
  getCalendarTableMetadata: () -> (GetTableMetadataOutputType__1) query;
  getCanistergeekInformation: (GetInformationRequest) ->
   (GetInformationResponse) query;
  getCurrentCanisterPrincipal: () -> (text) query;
  getEventMetaDataFromStartToEndDate: (nat, nat, vec text) ->
   (Result_2) query;
  getEventMetadataById: (text) -> (Result_1) query;
  getEventMetadataId: (text, text) -> (text) query;
  getFile: (text) -> (GetFileOutputType) query;
  getUser: () -> (opt UserPayload) query;
  getUserByPrincipalId: (text) -> (opt UserPayload) query;
  getUserDetailsByUsername: (text) -> (opt UserPayload) query;
  getUserEventMetadataTableMetadata: () ->
   (GetTableMetadataOutputType__1) query;
  getUserForEventCanister: (text) -> (EventUserResponsePayload) query;
  getUserTableMetadata: () -> (GetTableMetadataOutputType__1) query;
  getUserTest: (text) -> (opt UserPayload) query;
  get_trusted_origins: () -> (vec text) query;
  http_request: (HttpRequest) -> (HttpResponse) query;
  http_request_streaming_callback: (StreamingCallbackToken) ->
   (StreamingCallbackHttpResponse) query;
  icrc28_trusted_origins: () -> (record {trusted_origins: vec text;}) query;
  isWhiteListUser: (text) -> (bool);
  migrateUserDataFromMap: (principal) -> (text);
  queryOperation: (record {queryOpsInput: QueryOpsInputType;}) ->
   (QueryOpsOutputType) query;
  readStableMap: () -> (vec ReadStableMapResponse) query;
  removeCalendarEvent: (text) -> (Result);
  saveFile: (StoreFileInputType) -> (text);
  updateCanistergeekInformation: (UpdateInformationRequest) -> ();
  updateEventMetaData: (text, EventMetadataRequestPayload) -> (Result);
  updateEventMetadataForAttendee:
   (record {
      eventId: text;
      eventMetadataPayload: EventMetadataRequestPayload;
    }) -> (Result);
  updateOperation: (record {updateOpsInput: UpdateOpsInputType;}) ->
   (UpdateOpsOutputType);
  upsertCalendarData: (text, text, CalendarRequestPayload) -> (text);
  upsertUser: (UserRequestPayload) -> (text);
  upsertUserRecordWithAnonymousPrincipal: (text, UserRequestPayload) ->
   (text);
  upsertUserTest: (text, UserRequestPayload) -> (text);
}
