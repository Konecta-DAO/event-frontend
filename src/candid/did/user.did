type UserRequestPayload = 
 record {
   bio: opt text;
   categories: opt vec text;
   country: text;
   coverphoto: opt text;
   email: text;
   firstname: text;
   introduction_video_link: opt text;
   lastname: text;
   principal_id: opt text;
   profilepic: opt text;
   timezone: text;
   username: text;
 };
type UserPayload = 
 record {
   bio: text;
   canister_id: principal;
   categories: vec text;
   country: text;
   coverphoto: text;
   email: text;
   firstname: text;
   introduction_video_link: text;
   lastname: text;
   principal_id: principal;
   profilepic: text;
   timezone: text;
   username: text;
 };
type UpdateOpsOutputType = 
 variant {
   AddAttributeOutput: AddAttributeOutputType;
   CreateDatabaseOutput: CreateDatabaseOutputType;
   CreateIndexOutput: CreateIndexOutputType;
   CreateItemOutput: CreateItemOutputType;
   CreateTableOutput: CreateTableOutputType;
   DeleteDatabaseOutput: DeleteDatabaseOutputType;
   DeleteItemOutput: DeleteItemOutputType;
   DeleteTableOutput: DeleteTableOutputType;
   DropAttributeOutput: DropAttributeOutputType;
   UpdateItemOutput: UpdateItemOutputType;
 };
type UpdateOpsInputType = 
 variant {
   AddAttributeInput: AddAttributeInputType;
   CreateDatabaseInput: CreateDatabaseInputType;
   CreateIndexInput: CreateIndexInputType;
   CreateItemInput: CreateItemInputType;
   CreateTableInput: CreateTableInputType;
   DeleteDatabaseInput: DeleteDatabaseInputType;
   DeleteItemInput: DeleteItemInputType;
   DeleteTableInput: DeleteTableInputType;
   DropAttributeInput: DropAttributeInputType;
   UpdateItemInput: UpdateItemInputType;
 };
type UpdateItemOutputType = 
 variant {
   err: vec text;
   ok: record {
         id: text;
         item: vec record {
                     text;
                     AttributeDataValue;
                   };
       };
 };
type UpdateItemInputType = 
 record {
   attributeDataValues: vec record {
                              text;
                              AttributeDataValue;
                            };
   databaseName: text;
   id: text;
   tableName: text;
 };
type UpdateInformationRequest = record {
                                  metrics: opt CollectMetricsRequestType;};
type UpdateEventMetadataPayload = 
 record {
   calendar_id: opt text;
   created_by: opt principal;
   end_date: opt nat;
   event_id: text;
   name: opt text;
   start_date: opt nat;
   status: EventStatus;
 };
type UpdateCallsAggregatedData = vec nat64;
type TableMetadataOutputType = 
 record {
   attributes: vec AttributeMetadata;
   indexes: vec TableIndexMetadata;
 };
type TableIndexMetadata = 
 record {
   attributeNames: vec AttributeName;
   name: IndexName;
   unique: bool;
 };
type StringAttributeDataValue = 
 variant {
   char: nat32;
   "text": text;
 };
type StreamingStrategy = variant {
                           Callback:
                            record {
                              callback: StreamingCallback;
                              token: StreamingCallbackToken;
                            };};
type StreamingCallbackToken = 
 record {
   chunk_size: nat64;
   file_id: text;
   file_size: nat64;
   index: nat64;
 };
type StreamingCallbackHttpResponse = 
 record {
   body: blob;
   token: opt StreamingCallbackToken;
 };
type StreamingCallback = func (StreamingCallbackToken) ->
                          (StreamingCallbackHttpResponse) query;
type StoreFileInputType = 
 record {
   fileDataObject: blob;
   fileName: text;
   fileType: text;
 };
type StatusResponse = 
 record {
   cycles: opt nat64;
   heap_memory_size: opt nat64;
   memory_size: opt nat64;
 };
type StatusRequest = 
 record {
   cycles: bool;
   heap_memory_size: bool;
   memory_size: bool;
 };
type ScanOutputType = 
 variant {
   err: vec text;
   ok: vec record {
             id: text;
             item: vec record {
                         text;
                         AttributeDataValue;
                       };
           };
 };
type ScanInputType = 
 record {
   databaseName: text;
   filter: QueryFilter;
   tableName: text;
 };
type ScanAndGetIdsOutputType = 
 variant {
   err: vec text;
   ok: record {ids: vec text;};
 };
type ScanAndGetIdsInputType = 
 record {
   databaseName: text;
   filter: QueryFilter;
   tableName: text;
 };
type Result_2 = 
 variant {
   err: vec text;
   ok: vec EventMetadataResponsePayload;
 };
type Result_1 = 
 variant {
   err: vec text;
   ok: EventMetadataResponsePayload;
 };
type Result = 
 variant {
   err: text;
   ok: text;
 };
type RelationalExpressionAttributeDataValue = 
 variant {
   "blob": blob;
   "bool": bool;
   char: nat32;
   float: float64;
   "int": int;
   "int16": int16;
   "int32": int32;
   "int64": int64;
   "int8": int8;
   "nat": nat;
   "nat16": nat16;
   "nat32": nat32;
   "nat64": nat64;
   "nat8": nat8;
   "principal": principal;
   "text": text;
 };
type QueryPlan = 
 variant {
   FullTableScan: record {filter: QueryFilter;};
   IndexScan:
    record {
      indexName: text;
      remainingFilter: QueryFilter;
      scanBounds: record {
                    lower: text;
                    upper: text;
                  };
    };
 };
type QueryOpsOutputType = 
 variant {
   BatchGetItemByIdOutput: BatchGetItemByIdOutputType;
   GetDatabasesOutput: GetDatabasesOutputType;
   GetItemByIdOutput: GetItemByIdOutputType;
   GetItemCountOutput: GetItemCountOutputType;
   GetTableMetadataOutput: GetTableMetadataOutputType;
   PaginatedScanOutput: PaginatedScanOutputType;
   ScanAndGetIdsOutput: ScanAndGetIdsOutputType;
   ScanOutput: ScanOutputType;
 };
type QueryOpsInputType = 
 variant {
   BatchGetItemByIdInput: BatchGetItemByIdInputType;
   GetDatabasesInput: GetDatabasesInputType;
   GetItemByIdInput: GetItemByIdInputType;
   GetItemCountInput: GetItemCountInputType;
   GetTableMetadataInput: GetTableMetadataInputType;
   PaginatedScanInput: PaginatedScanInputType;
   ScanAndGetIdsInput: ScanAndGetIdsInputType;
   ScanInput: ScanInputType;
 };
type QueryFilter = 
 variant {
   AND: vec QueryFilter;
   OR: vec QueryFilter;
   expression: FilterExpressionType;
 };
type PaginatedScanOutputType = 
 variant {
   err: vec text;
   ok:
    record {
      hasMore: bool;
      items: vec ItemOutputType;
      limit: nat;
      nextCursor: opt PaginatedScanCursor;
    };
 };
type PaginatedScanInputType = 
 record {
   cursor: opt PaginatedScanCursor;
   databaseName: text;
   filter: QueryFilter;
   limit: nat;
   tableName: text;
 };
type PaginatedScanCursor = 
 record {
   lastId: text;
   plan: QueryPlan;
 };
type NumericEntity = 
 record {
   avg: nat64;
   first: nat64;
   last: nat64;
   max: nat64;
   min: nat64;
 };
type Nanos = nat64;
type MetricsResponse = record {metrics: opt CanisterMetrics;};
type MetricsRequest = record {parameters: GetMetricsParameters;};
type MetricsGranularity = 
 variant {
   daily;
   hourly;
 };
type LogMessagesData = 
 record {
   message: text;
   timeNanos: Nanos;
 };
type ItemOutputType = 
 record {
   id: text;
   item: vec record {
               text;
               AttributeDataValue;
             };
 };
type IndexName = text;
type HttpResponse = 
 record {
   body: blob;
   headers: vec HeaderField;
   status_code: nat16;
   streaming_strategy: opt StreamingStrategy;
 };
type HttpRequest = 
 record {
   body: blob;
   certificate_version: opt nat16;
   headers: vec HeaderField;
   method: text;
   url: text;
 };
type HourlyMetricsData = 
 record {
   canisterCycles: CanisterCyclesAggregatedData;
   canisterHeapMemorySize: CanisterHeapMemoryAggregatedData;
   canisterMemorySize: CanisterMemoryAggregatedData;
   timeMillis: int;
   updateCalls: UpdateCallsAggregatedData;
 };
type HeaderField = 
 record {
   text;
   text;
 };
type GetTableMetadataOutputType = 
 opt
  record {
    databaseName: text;
    metadata: TableMetadataOutputType;
    tableName: text;
  };
type GetTableMetadataInputType = 
 record {
   databaseName: text;
   tableName: text;
 };
type GetMetricsParameters = 
 record {
   dateFromMillis: nat;
   dateToMillis: nat;
   granularity: MetricsGranularity;
 };
type GetLogMessagesParameters = 
 record {
   count: nat32;
   filter: opt GetLogMessagesFilter;
   fromTimeNanos: opt Nanos;
 };
type GetLogMessagesFilter = 
 record {
   analyzeCount: nat32;
   messageContains: opt text;
   messageRegex: opt text;
 };
type GetLatestLogMessagesParameters = 
 record {
   count: nat32;
   filter: opt GetLogMessagesFilter;
   upToTimeNanos: opt Nanos;
 };
type GetItemCountOutputType = 
 variant {
   err: vec text;
   ok: record {count: nat;};
 };
type GetItemCountInputType = 
 record {
   databaseName: text;
   tableName: text;
 };
type GetItemByIdOutputType = 
 variant {
   err: vec text;
   ok: ItemOutputType;
 };
type GetItemByIdInputType = 
 record {
   databaseName: text;
   id: text;
   tableName: text;
 };
type GetInformationResponse = 
 record {
   logs: opt CanisterLogResponse;
   metrics: opt MetricsResponse;
   status: opt StatusResponse;
   version: opt nat;
 };
type GetInformationRequest = 
 record {
   logs: opt CanisterLogRequest;
   metrics: opt MetricsRequest;
   status: opt StatusRequest;
   version: bool;
 };
type GetFileOutputType = 
 opt
  record {
    fileData: blob;
    fileId: text;
    fileName: text;
    fileSize: nat64;
    fileType: text;
  };
type GetDatabasesOutputType = record {
                                databases:
                                 vec record {
                                       name: text;
                                       tables: vec text;
                                     };};
type GetDatabasesInputType = record {};
type FilterExpressionType = 
 record {
   attributeNames: text;
   filterExpressionCondition: FilterExpressionConditionType;
 };
type FilterExpressionConditionType = 
 variant {
   BEGINS_WITH: StringAttributeDataValue;
   BETWEEN:
    record {
      RelationalExpressionAttributeDataValue;
      RelationalExpressionAttributeDataValue;
    };
   CONTAINS: ContaintmentExpressionAttributeDataValue;
   EQ: RelationalExpressionAttributeDataValue;
   EXISTS;
   GT: RelationalExpressionAttributeDataValue;
   GTE: RelationalExpressionAttributeDataValue;
   IN: vec RelationalExpressionAttributeDataValue;
   LT: RelationalExpressionAttributeDataValue;
   LTE: RelationalExpressionAttributeDataValue;
   NEQ: RelationalExpressionAttributeDataValue;
   NOT_BETWEEN:
    record {
      RelationalExpressionAttributeDataValue;
      RelationalExpressionAttributeDataValue;
    };
   NOT_CONTAINS: ContaintmentExpressionAttributeDataValue;
   NOT_EXISTS;
 };
