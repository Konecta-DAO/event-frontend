   LIKE: vec RelationalExpressionAttributeDataValue;
   LT: RelationalExpressionAttributeDataValue;
   LTE: RelationalExpressionAttributeDataValue;
   NEQ: RelationalExpressionAttributeDataValue;
   NOT_BETWEEN:
