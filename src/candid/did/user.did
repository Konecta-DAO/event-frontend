type ContaintmentExpressionAttributeDataValue = 
 variant {
   char: nat32;
   list:
    vec
     variant {
       char: nat32;
       float: float64;
       "int": int;
       "int16": int16;
       "int32": int32;
       "int64": int64;
       "int8": int8;
       "nat": nat;
       "nat16": nat16;
       "nat32": nat32;
       "nat64": nat64;
       "nat8": nat8;
       "text": text;
     };
   "text": text;
 };
type CollectMetricsRequestType = 
 variant {
   force;
   normal;
 };
type CanisterStatus = 
 record {
   cycles: nat;
   idle_cycles_burned_per_day: nat;
   memory_size: nat;
   module_hash: opt vec nat8;
   settings:
    record {
      compute_allocation: nat;
      controllers: vec principal;
      freezing_threshold: nat;
      memory_allocation: nat;
    };
   status: variant {
             running;
             stopped;
             stopping;
           };
 };
type CanisterMetricsData = 
 variant {
   daily: vec DailyMetricsData;
   hourly: vec HourlyMetricsData;
 };
type CanisterMetrics = record {data: CanisterMetricsData;};
type CanisterMemoryAggregatedData = vec nat64;
type CanisterLogResponse = 
 variant {
   messages: CanisterLogMessages;
   messagesInfo: CanisterLogMessagesInfo;
 };
type CanisterLogRequest = 
 variant {
   getLatestMessages: GetLatestLogMessagesParameters;
   getMessages: GetLogMessagesParameters;
   getMessagesInfo;
 };
type CanisterLogMessagesInfo = 
 record {
   count: nat32;
   features: vec opt CanisterLogFeature;
   firstTimeNanos: opt Nanos;
   lastTimeNanos: opt Nanos;
 };
type CanisterLogMessages = 
 record {
   data: vec LogMessagesData;
   lastAnalyzedMessageTimeNanos: opt Nanos;
 };
type CanisterLogFeature = 
 variant {
   filterMessageByContains;
   filterMessageByRegex;
 };
type CanisterHeapMemoryAggregatedData = vec nat64;
type CanisterCyclesAggregatedData = vec nat64;
type CalendarRequestPayload = 
 record {
   description: text;
   name: text;
 };
type BatchGetItemByIdOutputType = 
 variant {
   err: vec text;
   ok: record {
         items: vec ItemOutputType;
         notFoundIds: vec text;
       };
 };
type BatchGetItemByIdInputType = 
 record {
   databaseName: text;
   ids: vec text;
   tableName: text;
 };
type AttributeName = text;
type AttributeMetadata = 
 record {
   dataType: AttributeDataType;
   defaultValue: AttributeDataValue;
   name: AttributeName;
   required: bool;
   unique: bool;
 };
type AttributeDataValue = 
 variant {
   "blob": blob;
   "bool": bool;
   char: nat32;
   default;
   float: float64;
   "int": int;
   "int16": int16;
   "int32": int32;
   "int64": int64;
   "int8": int8;
   list:
    vec
     variant {
       char: nat32;
       float: float64;
       "int": int;
       "int16": int16;
       "int32": int32;
       "int64": int64;
       "int8": int8;
       "nat": nat;
       "nat16": nat16;
       "nat32": nat32;
       "nat64": nat64;
       "nat8": nat8;
       "text": text;
     };
   map:
    vec
     record {
       text;
       variant {
         char: nat32;
         float: float64;
         "int": int;
         "int16": int16;
         "int32": int32;
         "int64": int64;
         "int8": int8;
         list:
          vec
           variant {
             char: nat32;
             float: float64;
             "int": int;
             "int16": int16;
             "int32": int32;
             "int64": int64;
             "int8": int8;
             "nat": nat;
             "nat16": nat16;
             "nat32": nat32;
             "nat64": nat64;
             "nat8": nat8;
             "text": text;
           };
         "nat": nat;
         "nat16": nat16;
         "nat32": nat32;
         "nat64": nat64;
         "nat8": nat8;
         "text": text;
       };
     };
   "nat": nat;
   "nat16": nat16;
   "nat32": nat32;
   "nat64": nat64;
   "nat8": nat8;
   "principal": principal;
   "text": text;
 };
type AttributeDataType = 
 variant {
   "blob";
   "bool";
   char;
   default;
   float;
   "int";
   "int16";
   "int32";
   "int64";
   "int8";
   list;
   map;
   "nat";
   "nat16";
   "nat32";
   "nat64";
   "nat8";
   "principal";
   "text";
 };
type AttendeeEventMetadataRequestPayload = 
 record {
   calendar_id: opt text;
   created_by: opt principal;
   end_date: opt nat;
   event_id: text;
   name: opt text;
   start_date: opt nat;
   status: EventStatus;
 };
type AddAttributeOutputType = 
 variant {
   err: vec text;
   ok: record {
         attributeNames: text;
         databaseName: text;
         tableName: text;
       };
 };
type AddAttributeInputType = 
 record {
   attribute: AttributeMetadata;
   databaseName: text;
   tableName: text;
 };
service : {
  approveCycleWithdrawal: (withdrawAmount: nat) -> ();
  createEventMetaData: (eventMetadataPayload: CreateEventMetadataPayload) ->
   (Result);
  fetchCanisterStatus: (_auxPrincipalId: opt principal) -> (CanisterStatus);
  generateSchema: () -> (text);
  getAllEventsMetadata: () -> (Result_2) query;
  getCalendarId: () -> (text) query;
  getCanistergeekInformation: (request: GetInformationRequest) ->
   (GetInformationResponse) query;
  getEventMetaDataFromStartToEndDate: (startDate: nat, endDate: nat,
   categories: vec text) -> (Result_2) query;
  getEventMetadataById: (eventMetadataId: text) -> (Result_1) query;
  getEventMetadataId: (eventId: text, calendarId: text) -> (text) query;
  getFile: (fileId: text) -> (GetFileOutputType) query;
  getUser: () -> (opt UserPayload) query;
  getUserForEventCanister: (userPrincipal: text) ->
   (EventUserResponsePayload) query;
  get_trusted_origins: () -> (vec text) query;
  http_request: (httpRequest: HttpRequest) -> (HttpResponse) query;
  http_request_streaming_callback: (streamingCallbackToken:
   StreamingCallbackToken) -> (StreamingCallbackHttpResponse) query;
  icrc28_trusted_origins: () -> (record {trusted_origins: vec text;}) query;
  queryOperation: (record {queryOpsInput: QueryOpsInputType;}) ->
   (QueryOpsOutputType) query;
  removeCalendarEvent: (eventMetadataId: text) -> (Result);
  saveFile: (file: StoreFileInputType) -> (text);
  updateCanistergeekInformation: (request: UpdateInformationRequest) -> ();
  updateEventMetaData: (eventMetadataId: text, eventMetadataPayload:
   UpdateEventMetadataPayload) -> (Result);
  updateEventMetadataForAttendee:
   (record {
      eventId: text;
      eventMetadataPayload: AttendeeEventMetadataRequestPayload;
    }) -> (Result);
  updateOperation: (record {updateOpsInput: UpdateOpsInputType;}) ->
   (UpdateOpsOutputType);
  upsertCalendarData: (calendarId: text, calendarPayload:
   CalendarRequestPayload) -> (text);
  upsertUser: (payload: UserRequestPayload) -> (text);
}
