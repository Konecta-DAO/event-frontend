  getEventsForAttendeeWithEventData: (text) -> (Result_3) query;
  getFile: (text) -> (GetFileOutputType) query;
  getFutureOrPastEvents: (nat, vec text, bool) ->
   (EventWithUserDataTupleArray) composite_query;
  getPaginatedEventsForAttendee: (text, nat, nat) ->
   (Result_2) composite_query;
  getUserDetailsByCompositeQuery: (text) ->
   (UserResponsePayload) composite_query;
  get_trusted_origins: () -> (vec text);
  http_request: (HttpRequest) -> (HttpResponse) query;
  http_request_streaming_callback: (StreamingCallbackToken) ->
   (StreamingCallbackHttpResponse) query;
  icrc28_trusted_origins: () -> (record {trusted_origins: vec text;}) query;
  isWhiteListUser: (text) -> (bool);
  queryOperation: (record {queryOpsInput: QueryOpsInputType;}) ->
   (QueryOpsOutputType) query;
  updateCanistergeekInformation: (UpdateInformationRequest) -> ();
  updateEvent: (text, text, EventRequestPayload) -> (Result_1);
  updateEventUsingUserPrincipal: (principal, text, text,
   EventRequestPayload) -> (Result_1);
  updateOperation: (record {updateOpsInput: UpdateOpsInputType;}) ->
   (UpdateOpsOutputType);
  withdrawEventAttendee: (WithdrawAttendeeRequestPayload) -> (Result);
}
