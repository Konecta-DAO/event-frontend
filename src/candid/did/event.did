type WithdrawAttendeeRequestPayload = 
 record {
   action: EventAttendeeActions;
   event_id: text;
   event_status: text;
   event_type: text;
   invitee_user_id: principal;
   timestamp: nat;
 };
type UserResponsePayload = 
 record {
   bio: text;
   canister_id: text;
   categories: vec text;
   country: text;
   coverphoto: text;
   email: text;
   firstname: text;
   introduction_video_link: text;
   lastname: text;
   principal_id: text;
   profilepic: text;
   timezone: text;
   username: text;
 };
type UpdateMultipleEventsResponse = 
 record {
   failed: vec record {
                 text;
                 text;
               };
   successful: vec text;
 };
type UpdateMultipleEventsPayload = 
 record {
   eventId: text;
   payload: EventRequestPayload;
 };
type UpdateInformationRequest = record {
                                  metrics: opt CollectMetricsRequestType;};
type UpdateCallsAggregatedData = vec nat64;
type Token = 
 variant {
   CKBTC;
   FREE;
   ICP;
 };
type TableMetadataOutputType = 
 record {
   attributes: vec AttributeMetadata;
   indexes: vec TableIndexMetadata;
 };
type TableIndexMetadata = 
 record {
   attributeNames: vec AttributeName;
   name: IndexName;
   unique: bool;
 };
type StringAttributeDataValue = 
 variant {
   char: nat32;
   "text": text;
 };
type StreamingStrategy = variant {
                           Callback:
                            record {
                              callback: StreamingCallback;
                              token: StreamingCallbackToken;
                            };};
type StreamingCallbackToken = 
 record {
   chunk_size: nat64;
   file_id: text;
   file_size: nat64;
   index: nat64;
 };
type StreamingCallbackHttpResponse = 
 record {
   body: blob;
   token: opt StreamingCallbackToken;
 };
type StreamingCallback = func (StreamingCallbackToken) ->
                          (StreamingCallbackHttpResponse) query;
type StatusResponse = 
 record {
   cycles: opt nat64;
   heap_memory_size: opt nat64;
   memory_size: opt nat64;
 };
type StatusRequest = 
 record {
   cycles: bool;
   heap_memory_size: bool;
   memory_size: bool;
 };
type Result_9 = 
 variant {
   err: text;
   ok: vec text;
 };
type Result_8 = 
 variant {
   err: vec text;
   ok: vec EventAttendeeResponsePayload;
 };
type Result_7 = 
 variant {
   err: vec text;
   ok: vec UserResponsePayload;
 };
type Result_6 = 
 variant {
   err: vec text;
   ok: vec EventResponsePayload;
 };
type Result_5 = 
 variant {
   err: vec text;
   ok: record {
         items: vec EventWithUserDataPayload;
         totalRecords: nat;
       };
 };
type Result_4 = 
 variant {
   err: vec text;
   ok: PaginatedProposalsResponse;
 };
type Result_3 = 
 variant {
   err: vec text;
   ok: PaginatedEventWithUserDataPayload;
 };
type Result_2 = 
 variant {
   err: vec text;
   ok: vec EventWithUserDataPayload;
 };
type Result_1 = 
 variant {
   err: text;
   ok: text;
 };
type Result = 
 variant {
   err: text;
   ok: EventWithUserDataPayload;
 };
type RelationalExpressionAttributeDataValue = 
 variant {
   "blob": blob;
   "bool": bool;
   char: nat32;
   float: float64;
   "int": int;
   "int16": int16;
   "int32": int32;
   "int64": int64;
   "int8": int8;
   "nat": nat;
   "nat16": nat16;
   "nat32": nat32;
   "nat64": nat64;
   "nat8": nat8;
   "principal": principal;
   "text": text;
 };
type RecordingVisibility = 
 variant {
   Private;
   Public;
 };
type QueryPlan = 
 variant {
   FullTableScan: record {filter: QueryFilter;};
   IndexScan:
    record {
      indexName: text;
      remainingFilter: QueryFilter;
      scanBounds: record {
                    lower: text;
                    upper: text;
                  };
    };
 };
type QueryFilter = 
 variant {
   AND: vec QueryFilter;
   OR: vec QueryFilter;
   expression: FilterExpressionType;
 };
type ProposalResponsePayload = 
 record {
   eventData: EventWithUserDataPayload;
   proposalMetadata: opt vec record {
                               text;
                               StringAttributeDataValue;
                             };
 };
type ParticipationType = 
 variant {
   PersonToMultiplePersons;
   PersonToPerson;
 };
type PaginatedScanCursor = 
 record {
   lastId: text;
   plan: QueryPlan;
 };
type PaginatedProposalsResponse = 
 record {
   hasMore: bool;
   items: vec ProposalResponsePayload;
   nextCursor: opt PaginatedScanCursor;
   totalRecords: nat;
 };
type PaginatedEventWithUserDataPayload = 
 record {
   hasMore: bool;
   items: vec EventWithUserDataPayload;
   nextCursor: opt PaginatedScanCursor;
   totalRecords: nat;
 };
type NumericEntity = 
 record {
   avg: nat64;
   first: nat64;
   last: nat64;
   max: nat64;
   min: nat64;
 };
type Nanos = nat64;
type MetricsResponse = record {metrics: opt CanisterMetrics;};
type MetricsRequest = record {parameters: GetMetricsParameters;};
type MetricsGranularity = 
 variant {
   daily;
   hourly;
 };
type LogMessagesData = 
 record {
   message: text;
   timeNanos: Nanos;
 };
type ItemOutputType = 
 record {
   id: text;
   item: vec record {
               text;
               AttributeDataValue;
             };
 };
type IndexName = text;
type HttpResponse = 
 record {
   body: blob;
   headers: vec HeaderField;
   status_code: nat16;
   streaming_strategy: opt StreamingStrategy;
 };
type HttpRequest = 
 record {
   body: blob;
   certificate_version: opt nat16;
   headers: vec HeaderField;
   method: text;
   url: text;
 };
type HourlyMetricsData = 
 record {
   canisterCycles: CanisterCyclesAggregatedData;
   canisterHeapMemorySize: CanisterHeapMemoryAggregatedData;
   canisterMemorySize: CanisterMemoryAggregatedData;
   timeMillis: int;
   updateCalls: UpdateCallsAggregatedData;
 };
type HeaderField = 
 record {
   text;
   text;
 };
type GetTableMetadataOutputType = 
 opt
  record {
    databaseName: text;
    metadata: TableMetadataOutputType;
    tableName: text;
  };
type GetMetricsParameters = 
 record {
   dateFromMillis: nat;
   dateToMillis: nat;
   granularity: MetricsGranularity;
 };
type GetLogMessagesParameters = 
 record {
   count: nat32;
   filter: opt GetLogMessagesFilter;
   fromTimeNanos: opt Nanos;
 };
type GetLogMessagesFilter = 
 record {
   analyzeCount: nat32;
   messageContains: opt text;
   messageRegex: opt text;
 };
type GetLatestLogMessagesParameters = 
 record {
   count: nat32;
   filter: opt GetLogMessagesFilter;
   upToTimeNanos: opt Nanos;
 };
type GetInformationResponse = 
 record {
   logs: opt CanisterLogResponse;
   metrics: opt MetricsResponse;
   status: opt StatusResponse;
   version: opt nat;
 };
type GetInformationRequest = 
 record {
   logs: opt CanisterLogRequest;
   metrics: opt MetricsRequest;
   status: opt StatusRequest;
   version: bool;
 };
type GetFileOutputType = 
 opt
  record {
    fileData: blob;
    fileId: text;
    fileName: text;
    fileSize: nat64;
    fileType: text;
  };
type FilterExpressionType = 
 record {
   attributeNames: text;
   filterExpressionCondition: FilterExpressionConditionType;
 };
type FilterExpressionConditionType = 
 variant {
   BEGINS_WITH: StringAttributeDataValue;
   BETWEEN:
    record {
      RelationalExpressionAttributeDataValue;
      RelationalExpressionAttributeDataValue;
    };
   CONTAINS: ContaintmentExpressionAttributeDataValue;
   EQ: RelationalExpressionAttributeDataValue;
   EXISTS;
   GT: RelationalExpressionAttributeDataValue;
   GTE: RelationalExpressionAttributeDataValue;
   IN: vec RelationalExpressionAttributeDataValue;
   LT: RelationalExpressionAttributeDataValue;
   LTE: RelationalExpressionAttributeDataValue;
   NEQ: RelationalExpressionAttributeDataValue;
   NOT_BETWEEN:
    record {
      RelationalExpressionAttributeDataValue;
      RelationalExpressionAttributeDataValue;
    };
   NOT_CONTAINS: ContaintmentExpressionAttributeDataValue;
   NOT_EXISTS;
 };
type EventWithUserDataTupleArray = 
 vec record {
       text;
       EventWithUserDataPayload;
     };
