service : {
  acceptApplication: (eventId: text, acceptedUserId: principal) -> (Result_1);
  addEventAttendee: (payload: EventAttendeeRequestPayload) -> (Result_1);
  cancelEvent: (userPrincipal: principal, eventId: text, eventType: text) ->
   (Result_9);
  checkIfAttendeeOrAcceptedUserExistsForEvent: (userPrincipal: principal,
   eventId: text) -> (bool) query;
  createEvent: (userCanisterId: text, payload: EventRequestPayload) -> (text);
  declineApplication: (eventId: text, declinedUserId: principal) ->
   (Result_1);
  fetchUserData: (userId: text, canisterId: text) ->
   (UserResponsePayload) composite_query;
  generateSchema: () -> (text);
  getAllAttendeesIds: (eventId: text) -> (Result_8) query;
  getAppliedUsersWithData: (eventId: text) -> (Result_7) composite_query;
  getAttendeeStatusForEvent: (userPrincipal: principal, eventId: text) ->
   (text) query;
  getAttendeesByActionWithUserDetails: (eventId: text, action:
   EventAttendeeActions) -> (Result_7) composite_query;
  getAttendeesByActionWithUserDetailsAsync: (eventId: text, action:
   EventAttendeeActions) -> (Result_7);
  getCanistergeekInformation: (request: GetInformationRequest) ->
   (GetInformationResponse) query;
  getCompletedEventsForCron: (startTime: nat, endTime: nat) -> (Result_2);
  getEventArrayFromEventIdArray: (eventIdArray: vec text) ->
   (EventWithUserDataTupleArray) composite_query;
  getEventDetailsWithUserData: (eventId: text) ->
   (EventWithUserDataPayload) composite_query;
  getEventDetailsWithUserDataAsync: (eventId: text) ->
   (EventWithUserDataPayload);
  getEventTableMetadata: () -> (GetTableMetadataOutputType) query;
  getEventsForAttendeeWithEventData: (userPrincipal: text) ->
   (Result_6) query;
  getEventsWithUserData: (events: vec ItemOutputType) ->
   (vec EventWithUserDataPayload) composite_query;
  getFile: (fileId: text) -> (GetFileOutputType) query;
  getFilteredEvents: (payload:
   record {
     categories: opt vec text;
     currentTimestamp: nat;
     eventType: opt text;
     isFuture: bool;
     limit: nat;
     offset: nat;
     recordingType: opt vec bool;
     status: opt text;
     userId: opt principal;
   }) -> (Result_5) composite_query;
  getMyPaginatedProposals: (userPrincipal: principal, limit: nat, cursor:
   opt PaginatedScanCursor) -> (Result_4) composite_query;
  getMyProposals: (userPrincipal: principal) -> (Result_2) composite_query;
  getPaginatedEventsForAttendee: (userPrincipal: text, limit: nat, cursor:
   opt PaginatedScanCursor) -> (Result_3) composite_query;
  getPaginatedFilteredEvents: (payload:
   record {
     categories: opt vec text;
     currentTimestamp: nat;
     cursor: opt PaginatedScanCursor;
     eventType: opt text;
     isFuture: bool;
     limit: nat;
     recordingType: opt vec bool;
     status: opt text;
     userId: opt principal;
   }) -> (Result_3) composite_query;
  getServiceRequestsForUser: (userPrincipal: principal) ->
   (Result_2) composite_query;
  get_trusted_origins: () -> (vec text) query;
  http_request: (httpRequest: HttpRequest) -> (HttpResponse) query;
  http_request_streaming_callback: (streamingCallbackToken:
   StreamingCallbackToken) -> (StreamingCallbackHttpResponse) query;
  icrc28_trusted_origins: () -> (record {trusted_origins: vec text;}) query;
  isWhiteListUser: (userId: text) -> (bool);
  updateCanistergeekInformation: (request: UpdateInformationRequest) -> ();
  updateEvent: (userCanisterId: text, eventId: text, payload:
   EventRequestPayload) -> (Result_1);
  updateEventAttendeeStatus: (eventId: text, inviteeUserId: principal,
   currentAction: EventAttendeeActions, newAction: EventAttendeeActions) ->
   (Result_1);
  updateMultipleEvents: (userCanisterId: text, updates:
   vec UpdateMultipleEventsPayload) -> (UpdateMultipleEventsResponse);
  withdrawEventAttendee: (payload: WithdrawAttendeeRequestPayload) ->
   (Result);
}
