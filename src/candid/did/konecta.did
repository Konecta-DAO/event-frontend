 };
type TransactionWithUserDataResponse = 
 record {
   amount: nat;
   beneficiary_user_data: opt TransactionUser;
   beneficiary_user_id: text;
   block_index: nat;
   created_at_time: nat64;
   destination_account_id_hex: text;
   eventData: FeedResponsePayloadWithoutUser;
   event_id: text;
   fee: nat;
   memo: blob;
   narration: text;
   remitter_user_id: text;
   source_account_id_hex: text;
   transaction_id: text;
   transferred_to_type: text;
   url: text;
 };
type TransactionUser = 
 record {
   email: text;
   firstname: text;
   lastname: text;
   username: text;
 };
type TransactionResponsePayload = 
 record {
   amount: nat;
   beneficiary_user_id: text;
   block_index: nat;
   created_at_time: nat64;
   destination_account_id_hex: text;
   event_id: text;
   fee: nat;
   memo: blob;
   narration: text;
   remitter_user_id: text;
   source_account_id_hex: text;
   transaction_id: text;
   transferred_to_type: text;
 };
type Token = 
 variant {
   CKBTC;
   FREE;
   ICP;
 };
type Timestamp = nat64;
type TableMetadataOutputType = 
 record {
   attributes: vec AttributeMetadata;
   indexes: vec TableIndexMetadata;
 };
type TableIndexMetadata = 
 record {
   attributeNames: vec AttributeName;
   name: IndexName;
   unique: bool;
 };
type StringAttributeDataValue = 
 variant {
   char: nat32;
   "text": text;
 };
type StatusResponse = 
 record {
   cycles: opt nat64;
   heap_memory_size: opt nat64;
   memory_size: opt nat64;
 };
type StatusRequest = 
 record {
   cycles: bool;
   heap_memory_size: bool;
   memory_size: bool;
 };
