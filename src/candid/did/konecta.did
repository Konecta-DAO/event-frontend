                              text;
                              AttributeDataValue;
                            };
   databaseName: text;
   tableName: text;
 };
type CreateIndexOutputType = 
 variant {
   err: vec text;
   ok: record {
         databaseName: text;
         indexName: text;
         tableName: text;
       };
 };
type CreateIndexInputType = 
 record {
   databaseName: text;
   index: TableIndexMetadata;
   tableName: text;
 };
type CreateDatabaseOutputType = 
 variant {
   err: vec text;
   ok: record {};
 };
type CreateDatabaseInputType = record {name: text;};
type ContaintmentExpressionAttributeDataValue = 
 variant {
   char: nat32;
   list:
    vec
     variant {
       char: nat32;
       float: float64;
       "int": int;
       "int16": int16;
       "int32": int32;
       "int64": int64;
       "int8": int8;
       "nat": nat;
       "nat16": nat16;
       "nat32": nat32;
       "nat64": nat64;
       "nat8": nat8;
       "text": text;
     };
   "text": text;
 };
type CollectMetricsRequestType = 
 variant {
   force;
   normal;
 };
type CanisterMetricsData = 
 variant {
   daily: vec DailyMetricsData;
   hourly: vec HourlyMetricsData;
 };
type CanisterMetrics = record {data: CanisterMetricsData;};
type CanisterMemoryAggregatedData = vec nat64;
type CanisterLogResponse = 
 variant {
   messages: CanisterLogMessages;
   messagesInfo: CanisterLogMessagesInfo;
 };
type CanisterLogRequest = 
 variant {
   getLatestMessages: GetLatestLogMessagesParameters;
   getMessages: GetLogMessagesParameters;
   getMessagesInfo;
 };
type CanisterLogMessagesInfo = 
 record {
   count: nat32;
   features: vec opt CanisterLogFeature;
   firstTimeNanos: opt Nanos;
   lastTimeNanos: opt Nanos;
 };
type CanisterLogMessages = 
 record {
   data: vec LogMessagesData;
   lastAnalyzedMessageTimeNanos: opt Nanos;
 };
type CanisterLogFeature = 
 variant {
   filterMessageByContains;
   filterMessageByRegex;
 };
type CanisterHeapMemoryAggregatedData = vec nat64;
type CanisterCyclesAggregatedData = vec nat64;
type BatchGetItemByIdOutputType = 
 variant {
   err: vec text;
   ok: record {
         items: vec ItemOutputType;
         notFoundIds: vec text;
       };
 };
type BatchGetItemByIdInputType = 
 record {
   databaseName: text;
   ids: vec text;
   tableName: text;
 };
type AttributeName = text;
type AttributeMetadata = 
 record {
   dataType: AttributeDataType;
   defaultValue: AttributeDataValue;
   name: AttributeName;
   required: bool;
   unique: bool;
 };
type AttributeDataValue = 
 variant {
   "blob": blob;
   "bool": bool;
   char: nat32;
   default;
   float: float64;
   "int": int;
   "int16": int16;
   "int32": int32;
   "int64": int64;
   "int8": int8;
   list:
    vec
     variant {
       char: nat32;
       float: float64;
       "int": int;
       "int16": int16;
       "int32": int32;
       "int64": int64;
       "int8": int8;
       "nat": nat;
       "nat16": nat16;
       "nat32": nat32;
       "nat64": nat64;
       "nat8": nat8;
       "text": text;
     };
   map:
    vec
     record {
       text;
       variant {
         char: nat32;
         float: float64;
         "int": int;
         "int16": int16;
         "int32": int32;
         "int64": int64;
         "int8": int8;
         list:
          vec
           variant {
             char: nat32;
             float: float64;
             "int": int;
             "int16": int16;
             "int32": int32;
             "int64": int64;
             "int8": int8;
             "nat": nat;
             "nat16": nat16;
             "nat32": nat32;
             "nat64": nat64;
             "nat8": nat8;
             "text": text;
           };
         "nat": nat;
         "nat16": nat16;
         "nat32": nat32;
         "nat64": nat64;
         "nat8": nat8;
         "text": text;
       };
     };
   "nat": nat;
   "nat16": nat16;
   "nat32": nat32;
   "nat64": nat64;
   "nat8": nat8;
   "principal": principal;
   "text": text;
 };
type AttributeDataType = 
 variant {
   "blob";
   "bool";
   char;
   default;
   float;
   "int";
   "int16";
   "int32";
   "int64";
   "int8";
   list;
   map;
   "nat";
   "nat16";
   "nat32";
   "nat64";
   "nat8";
   "principal";
   "text";
 };
type ApplyToServiceRequestPayload = 
 record {
   event_id: text;
   location: text;
   note: text;
 };
type ApplicationStatusOfMyCreatedEvents = 
 record {
   applied_users_details: vec ApplicantDetailsPayload;
   event_description: text;
   event_id: text;
   event_name: text;
 };
type ApplicantDetailsPayload = 
 record {
   applicationMetadata: opt vec record {
                                  text;
                                  StringAttributeDataValue;
                                };
   applicationStatus: text;
   applicationTimestamp: nat;
   userData: UserResponsePayload;
 };
type AddAttributeOutputType = 
 variant {
   err: vec text;
   ok: record {
         attributeNames: text;
         databaseName: text;
         tableName: text;
       };
 };
type AddAttributeInputType = 
 record {
   attribute: AttributeMetadata;
   databaseName: text;
   tableName: text;
 };
service : {
