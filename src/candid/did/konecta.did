     recordingType: opt vec bool;
     status: opt text;
     userId: opt principal;
   }) -> (Result_6) composite_query;
  getPaginatedJoinedOffersForMyProfile: (limit: nat, cursor:
   opt PaginatedScanCursor) -> (Result_6) composite_query;
  getPaginatedJoinedRequestsForMyProfile: (limit: nat, cursor:
