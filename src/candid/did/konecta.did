  getUserDetailsByCompositeQuery: (userId: text) ->
   (UserResponsePayload) composite_query;
  getUserFeedbackTableMetadata: () -> (GetTableMetadataOutputType) query;
  getUserStatusForServiceOffers: (userPrincipal: principal, eventId: 
   text) -> (text) composite_query;
  get_trusted_origins: () -> (vec text) query;
  icrc28_trusted_origins: () -> (record {trusted_origins: vec text;}) query;
  insertExpertFeedback: (payload: ExpertFeedbackRequestPayload) -> (Result);
  insertMultipleUserFeedback: (payload: vec UserFeedbackRequestPayload) ->
   (Result_4);
  insertUserFeedback: (payload: UserFeedbackRequestPayload) -> (Result_3);
  isWhiteListUser: (userId: text) -> (bool);
  joinPublicEvent: (eventId: text) -> (Result);
  queryOperation: (record {queryOpsInput: QueryOpsInputType;}) ->
