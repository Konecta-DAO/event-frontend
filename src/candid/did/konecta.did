 };
type RelationalExpressionAttributeDataValue = 
 variant {
   "blob": blob;
   "bool": bool;
   char: nat32;
   float: float64;
   "int": int;
   "int16": int16;
   "int32": int32;
   "int64": int64;
   "int8": int8;
   "nat": nat;
   "nat16": nat16;
   "nat32": nat32;
   "nat64": nat64;
   "nat8": nat8;
   "principal": principal;
   "text": text;
 };
type QueryPlan = 
 variant {
   FullTableScan: record {filter: QueryFilter;};
   IndexScan:
    record {
      indexName: text;
      remainingFilter: QueryFilter;
      scanBounds: record {
                    lower: text;
                    upper: text;
                  };
    };
 };
type QueryOpsOutputType = 
 variant {
   BatchGetItemByIdOutput: BatchGetItemByIdOutputType;
   GetDatabasesOutput: GetDatabasesOutputType;
   GetItemByIdOutput: GetItemByIdOutputType;
   GetItemCountOutput: GetItemCountOutputType;
   GetTableMetadataOutput: GetTableMetadataOutputType;
   PaginatedScanOutput: PaginatedScanOutputType;
   ScanAndGetIdsOutput: ScanAndGetIdsOutputType;
   ScanOutput: ScanOutputType;
 };
type QueryOpsInputType = 
 variant {
   BatchGetItemByIdInput: BatchGetItemByIdInputType;
   GetDatabasesInput: GetDatabasesInputType;
   GetItemByIdInput: GetItemByIdInputType;
   GetItemCountInput: GetItemCountInputType;
   GetTableMetadataInput: GetTableMetadataInputType;
   PaginatedScanInput: PaginatedScanInputType;
   ScanAndGetIdsInput: ScanAndGetIdsInputType;
   ScanInput: ScanInputType;
 };
type QueryFilter = 
 variant {
   AND: vec QueryFilter;
   OR: vec QueryFilter;
   expression: FilterExpressionType;
 };
type PaginatedTransactionWithUserDataResponse = 
 record {
   hasMore: bool;
   items: vec TransactionWithUserDataResponse;
   nextCursor: opt PaginatedScanCursor;
   totalRecords: nat;
 };
type PaginatedTransactionResponsePayload = 
 record {
   items: vec TransactionResponsePayload;
   limit: nat;
   nonScannedItemCount: int;
   offset: nat;
   scannedItemCount: int;
   totalRecords: nat;
 };
type PaginatedScanOutputType = 
 variant {
   err: vec text;
   ok:
    record {
      hasMore: bool;
      items: vec ItemOutputType;
      limit: nat;
      nextCursor: opt PaginatedScanCursor;
    };
 };
type PaginatedScanInputType = 
 record {
   cursor: opt PaginatedScanCursor;
   databaseName: text;
   filter: QueryFilter;
   limit: nat;
   tableName: text;
 };
type PaginatedScanCursor = 
 record {
   lastId: text;
   plan: QueryPlan;
 };
type PaginatedFeedResponsePayload = 
 record {
   hasMore: bool;
   items: vec FeedResponsePayload;
   nextCursor: opt PaginatedScanCursor;
   totalRecords: nat;
 };
type PaginatedApplicationStatusOfMyCreatedEvents = 
 record {
   hasMore: bool;
   items: vec ApplicationStatusOfMyCreatedEvents;
   nextCursor: opt PaginatedScanCursor;
   totalRecords: nat;
 };
type NumericEntity = 
 record {
   avg: nat64;
   first: nat64;
   last: nat64;
   max: nat64;
   min: nat64;
 };
type Nanos = nat64;
type MoneyTransferActions = 
 variant {
   RefundToRemitter;
   TransferToBeneficiary;
 };
type MissingFeedbackEvent = 
 record {
   end_date: nat;
   event_id: text;
   name: text;
   start_date: nat;
 };
