   coverphoto: text;
   email: text;
   firstname: text;
   introduction_video_link: text;
   lastname: text;
   principal_id: text;
   profilepic: text;
   timezone: text;
   username: text;
 };
type UserFeedbackResponsePayload = 
 record {
   email: text;
   event_id: text;
   firstname: text;
   id: text;
   lastname: text;
   rating: nat;
   reason: text;
   recording_link: text;
   successful: text;
   timezone: text;
   user_id: text;
   user_type: text;
   username: text;
 };
