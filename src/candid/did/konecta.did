  getListOfUserActionEmails: () -> (Result_10) query;
  getListOfUserFeedbackForwardedEmailsToExpert: () -> (Result_9) query;
  getListOfUserFeedbacks: () -> (Result_8) query;
  getMissingFeedbackEventArray: (eventIds: vec text) ->
