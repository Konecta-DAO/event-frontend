{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@dfinity/agent": "^2.4.1",
    "@dfinity/auth-client": "^2.4.1",
    "@dfinity/candid": "^2.4.1",
    "@dfinity/identity": "^2.4.1",
    "@dfinity/ledger-icp": "^2.6.13",
    "@dfinity/principal": "^2.4.1",
    "@dfinity/utils": "^2.13.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@mui/icons-material": "^7.3.2",
    "@mui/joy": "^5.0.0-beta.23",
    "@mui/material": "^7.3.2",
    "@mui/x-date-pickers": "^8.11.0",
    "@nfid/embed": "^0.10.1-alpha.1",
    "@nfid/identitykit": "^1.0.14",
    "@reduxjs/toolkit": "^2.1.0",
    "@sentry/react": "^6.2.2",
    "dayjs": "^1.11.18",
    "immutability-helper": "^3.1.1",
    "moment": "^2.30.1",
    "query-string": "^9.0.0",
    "react": "19.1.1",
    "react-big-calendar": "^1.10.3",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.50.1",
    "react-qr-code": "^2.0.15",
    "react-redux": "^9.1.0",
    "react-router": "^7.8.2",
    "react-router-dom": "^7.8.2",
    "react-share": "^5.1.0",
    "slick-carousel": "^1.8.1"
  },
  "scripts": {
    "setup": "npm i && dfx deploy",
    "start": "watch:css && run-p frontend",
    "frontend": "vite --port 3000 --host",
    "dev": "vite --host --port 3000",
    "backend": "mo-dev --generate --deploy -y",
    "build": "tsc && vite build",
    "test": "run-s test:backend test:frontend",
    "test:frontend": "vitest run",
    "test:backend": "mo-test",
    "format": "prettier --write \"src/**/*.{json,js,jsx,ts,tsx,css,scss}\" \"backend/**/*.mo\"",
    "build:css": "postcss src/assets/tailwind.css -o src/assets/main.css",
    "watch:css": "postcss src/assets/tailwind.css -o src/assets/main.css",
    "lint-check": "eslint 'src/**/*.{ts,tsx,js}'",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --fix",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@types/lodash": "^4.17.20",
    "@types/react": "^19.1.11",
    "@types/react-big-calendar": "^1.8.8",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@vitejs/plugin-react": "^4.0.1",
    "autoprefixer": "^10.4.21",
    "cross-fetch": "^3.1.6",
    "dotenv": "^16.3.1",
    "eslint": "^8.0.1",
    "eslint-config-standard-with-typescript": "^43.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^8.0.0",
    "jsdom": "^22.1.0",
    "lint-staged": "^15.2.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.33",
    "postcss-cli": "^11.0.1",
    "prettier": "^2.2.1",
    "sass": "^1.71.1",
    "source-map-explorer": "^2.5.2",
    "storybook": "7.6.7",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-visuallyhidden": "^1.0.2",
    "typescript": "^5.8.3",
    "vite": "^4.3.9",
    "vite-plugin-environment": "^1.1.3",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.js": "eslint --cache --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
